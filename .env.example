# OpenAI (https://platform.openai.com)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# 금융감독원 금융상품통합비교공시 오픈API (https://finlife.fss.or.kr 에서 인증키 신청)
FINLIFE_API_KEY=

# LangSmith 트레이싱 (선택 사항, https://smith.langchain.com)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# 데이터베이스 — Neon(무료 PostgreSQL) 연결 문자열을 그대로 붙여넣으면 됩니다.
# 예: postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/dbname?sslmode=require
# 비워두면 로컬 SQLite로 동작하고, 조건 검색(RAG) 기능은 꺼집니다.
DATABASE_URL=
